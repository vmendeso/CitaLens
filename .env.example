# Run python scripts/setup_env.py or PowerShell scripts/setup-env.ps1 before Compose.
# Generated local-only secrets. Do not commit .env.
POSTGRES_PASSWORD=CHANGE_ME
API_DB_PASSWORD=CHANGE_ME
KNOWLEDGE_DB_PASSWORD=CHANGE_ME
UPLOAD_DB_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
INTERNAL_TOKEN=CHANGE_ME
JWT_SECRET=CHANGE_ME
WEAVIATE_API_KEY=CHANGE_ME
SEARXNG_SECRET_KEY=CHANGE_ME
JWT_EXPIRATION_MINUTES=480
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DEMO_ENABLED=true
# Groq serves this model; missing GROQ_API_KEY yields an inconclusive assessment.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Optional credential for the OpenAI adapter or OpenAI embeddings.
OPENAI_API_KEY=
# Local multilingual BGE-M3 (MIT), downloaded by ollama-pull on first startup.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_DIMENSIONS=1024
EMBEDDING_VERSION=2
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT=120
# Local open-source search; Crossref supplies bibliographic metadata.
WEB_PROVIDER=searxng
SEARXNG_BASE_URL=http://searxng:8080
# Optional paid Brave adapter; no external API key is needed for SearXNG.
BRAVE_API_KEY=
CROSSREF_MAILTO=
# Academic discovery; obtain a key at openalex.org (Settings > API key).
# Anonymous metadata queries work with a smaller quota; cached PDFs need a key.
OPENALEX_ENABLED=true
OPENALEX_API_KEY=
MAX_PDF_BYTES=31457280
MAX_PDF_PAGES=500
MAX_SOURCE_BYTES=20971520
MAX_SOURCE_PAGES=400
OCR_LANGUAGES=por+eng
REQUEST_TIMEOUT=60
STAGE_TIMEOUT=900
MAX_EXTERNAL_QUERIES=100
MAX_ANALYSIS_TOKENS=200000
MAX_ANALYSIS_SECONDS=3600
WEAVIATE_HOST=weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
STORAGE_ROOT=/data/files
UPLOAD_URL=http://upload-service:8000
OCR_URL=http://ocr-service:8000
CHUNK_URL=http://chunk-service:8000
VECTOR_URL=http://vector-service:8000
KNOWLEDGE_URL=http://knowledge-service:8000
RAG_URL=http://rag-service:8000
LLM_URL=http://llm-service:8000
WEB_SEARCH_URL=http://web-search-service:8000
REPORT_URL=http://report-service:8000
# Compose sets DATABASE_URL and BROKER_URL separately with the proper service role.
